			"workflows": {
				"publish": {
					"file": "publish.yml",
					"mode": "observe",
					"publications": ["pkg:jsr/%40kjanat/dreamcli", "pkg:npm/%40kjanat/dreamcli"]
				}
			}
		}
	},
	"managers": ["jsr", "npm", "workflow"]
}
