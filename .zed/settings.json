// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"terminal": {
		"shell": "system"
	},
	"hard_tabs": true,
	"tab_size": 2,
	"wrap_guides": [100],
	"file_types": { "Markdown": ["LICENSE"], "TypeScript": ["*.ts.tpl"] },
	"prettier": { "allowed": false },
	"formatter": [
		{ "language_server": { "name": "dprint" } }, // just in case...
		{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }
	],
	"languages": {
		"JavaScript": {
			"formatter": [
				{ "language_server": { "name": "biome" } },
				{ "language_server": { "name": "dprint" } },
				{
					"external": {
						"command": "bunx",
						"arguments": ["dprint", "fmt", "--stdin", "{buffer_path}"]
					}
				}
			],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"language_servers": [
				"typescript-ls",
				"biome",
				"oxlint",
				"deno",
				"!typescript-language-server"
			]
		},
		"TypeScript": {
			"formatter": [
				{ "language_server": { "name": "biome" } },
				{ "language_server": { "name": "dprint" } },
				{
					"external": {
						"command": "bunx",
						"arguments": ["dprint", "fmt", "--stdin", "{buffer_path}"]
					}
				}
			],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			},
			"language_servers": [
				"typescript-ls",
				"biome",
				"oxlint",
				"deno",
				"vue-language-server",
				"!typescript-language-server"
			]
		}
	},
	"lsp": {
		"deno": {
			"settings": {
				"deno": {
					"enable": true,
					"enablePaths": ["./src", "./scripts/deno-smoke-test.ts"],
					"config": "./deno.json",
					"importMap": "./import_map.json"
				}
			}
		},
		"vtsls": {
			"initialization_options": {
				// https://github.com/yioneko/vtsls/blob/04c4d90fb4f18dff34d9282cdb7f508aab12cd95/packages/service/configuration.schema.json#L380
				"typescript": {
					"preferences": { "importModuleSpecifier": "non-relative" }
				}
			}
		},
		"dprint": {
			"binary": { "path": "bunx", "arguments": ["dprint", "lsp"] }
		},
		"json-language-server": {
			"settings": {
				"json": {
					"schemas": [
						{
							"fileMatch": [".attw.json"],
							"url": "https://gist.githubusercontent.com/kjanat/46efa8c04bf3ed10c406d1965c546177/raw/3e85defc22383f8689a130785321d7da37f3677d/attw.schema.json"
						},
						{
							"fileMatch": ["typedoc.json"],
							"url": "https://typedoc.org/schema.json"
						}
					]
				}
			}
		}
	}
}
