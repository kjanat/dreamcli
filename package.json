{
	"name": "@kjanat/dreamcli",
	"version": "2.4.0",
	"description": "Schema-first, fully typed TypeScript CLI framework",
	"keywords": [
		"dreamcli",
		"cli",
		"typescript",
		"framework",
		"schema-first",
		"command-line"
	],
	"homepage": "https://dreamcli.kjanat.com",
	"bugs": {
		"url": "https://github.com/kjanat/dreamcli/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/dreamcli.git"
	},
	"license": "MIT",
	"author": {
		"name": "Kaj Kowalski",
		"email": "info@kajkowalski.nl",
		"url": "https://github.com/kjanat"
	},
	"type": "module",
	"imports": {
		"#dreamcli": "./src/index.ts",
		"#dreamcli/runtime": "./src/runtime.ts",
		"#dreamcli/testkit": "./src/testkit.ts",
		"#internals/*": "./src/*",
		"#schema": "./dreamcli.schema.json",
		"#package.json": "./package.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"bun": "./src/index.ts",
			"deno": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"bun": "./src/runtime.ts",
			"deno": "./src/runtime.ts",
			"default": "./dist/runtime.mjs"
		},
		"./testkit": {
			"types": "./dist/testkit.d.mts",
			"bun": "./src/testkit.ts",
			"deno": "./src/testkit.ts",
			"default": "./dist/testkit.mjs"
		},
		"./schema": "./dreamcli.schema.json",
		"./package.json": "./package.json"
	},
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"dist",
		"dreamcli.schema.json",
		"examples",
		"!examples/.cache",
		"package.json",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*test-helpers.ts",
		"!**/AGENTS.md"
	],
	"workspaces": [
		"./examples/*"
	],
	"scripts": {
		"bd": "bunx --bun tsdown",
		"build": "bunx --bun tsdown",
		"build:watch": "bunx --bun tsdown --watch",
		"ci": "run -pk typecheck lint format:check meta-descriptions:check test docs:build bd",
		"coverage": "vitest run --coverage",
		"dev": "bunx --bun tsdown --logLevel silent --watch & bunx --bun vitepress@next dev docs --host --port ${PORT:-5173} & wait",
		"docs:build": "bunx --bun vitepress@next build docs",
		"docs:dev": "bunx --bun vitepress@next dev docs",
		"docs:preview": "bunx --bun vitepress@next preview docs",
		"fmt": "dprint fmt",
		"fmt:autofix": "dprint fmt --allow-no-files --excludes .github",
		"fmt:update": "dprint config update --yes --recursive",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"gh-project": "bun scripts/gh-project.ts",
		"gh-project:finish": "bun gh-project finish",
		"gh-project:list": "bun gh-project list",
		"gh-project:set": "bun gh-project set",
		"gh-project:start": "bun gh-project start",
		"gh-project:sync": "bun gh-project sync",
		"knip": "knip",
		"lint": "biome lint",
		"lint:autofix": "biome check --skip-parse-errors --no-errors-on-unmatched --changed --write",
		"lint:fix": "biome lint --fix",
		"meta-descriptions": "bun --bun scripts/build-meta-descriptions.ts",
		"meta-descriptions:check": "bun --bun scripts/build-meta-descriptions.ts --check",
		"prepack": "bunx --bun tsdown --logLevel silent",
		"publish:preview": "bunx pkg-pr-new publish --bun --comment=update --packageManager=bun,npm",
		"schema:emit": "bun scripts/emit-definition-schema.ts",
		"test": "vitest run",
		"test:bun": "bunx --bun vitest run",
		"test:gh": "run --dir examples/gh test",
		"test:node": "npx -y vitest run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"typecheck:gh": "run --dir examples/gh typecheck",
		"typecheck:tsc": "tsc --noEmit",
		"upgrade": "bun update --latest && bun add -D vitepress@next",
		"version:check": "bun scripts/check-version-sync.ts"
	},
	"overrides": {
		"vitepress": "next"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.4",
		"@biomejs/biome": "^2.5.1",
		"@iarna/toml": "^2.2.5",
		"@shikijs/transformers": "^4.2.0",
		"@shikijs/vitepress-twoslash": "^4.2.0",
		"@types/bun": "catalog:",
		"@types/deno": "^2.7.0",
		"@types/node": "catalog:",
		"@typescript/native-preview": "^7.0.0-dev",
		"@vitest/coverage-v8": "^4.1.9",
		"dprint": "^0.54.0",
		"floating-vue": "^5.2.2",
		"knip": "^6.18.0",
		"mermaid": "^11.15.0",
		"publint": "^0.3.21",
		"runner-run": "0.14.0",
		"tsdown": "^0.22.3",
		"typedoc": "^0.28.19",
		"typescript": "catalog:",
		"vite": "^8.1.0",
		"vitepress": "^2.0.0-alpha.17",
		"vitest": "^4.1.9",
		"wrangler": "^4.104.0",
		"yaml": "^2.9.0"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3",
		"deno": ">=2.6.0",
		"node": ">=22.22.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"onFail": "warn"
		},
		"runtime": {
			"name": "bun",
			"onFail": "ignore"
		}
	},
	"volta": {
		"node": "25.9.0",
		"npm": "11.12.1"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"catalog": {
		"@types/bun": "^1.3.14",
		"@types/node": ">=22.0.0, <23.0.0",
		"typescript": "^6.0.3"
	}
}
