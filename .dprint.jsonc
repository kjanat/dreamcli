{
	"useTabs": true,
	"indentWidth": 2,
	"newLineKind": "lf",
	"lineWidth": 100,
	"biome": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"quoteStyle": "single",
		"css.enabled": true,
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts", "*.ts.tpl"]
	},
	"markdown": {
		"textWrap": "maintain",
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts"]
	},
	"markup": {
		"html.void.selfClosing": false,
		"formatComments": true,
		"scriptIndent": true,
		"styleIndent": true,
		"vue.scriptIndent": true,
		"vue.styleIndent": true,
		"scriptFormatter": "biome",
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts"]
	},
	"yaml": { "printWidth": 160 },
	"svg": { "useTabs": false },
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"associations": ["**/*.toml"],
		"commands": [
			{
				"associations": ["**/*.toml"],
				"exts": ["toml"],
				"command": "tombi format - --stdin-filename {{file_path}}",
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "npm i -g tombi@latest"
			}
		]
	},
	"prettier": {
		"singleQuote": true,
		"plugin.jsDoc": true,
		"printWidth": 60,
		"tabWidth": 2,
		"useTabs": false,
		"endOfLine": "lf",
		"associations": ["README.md", "docs/**/*.md", "docs/.vitepress/twoslash/*.ts", "!**"]
	},
	"ruff": { "preview": true, "indentWidth": 4 },
	"excludes": ["**/node_modules", "**/{*-,bun}lock(.*)?", "**/snapshots", "**/*.schema.json"],
	"plugins": [
		"https://plugins.dprint.dev/kjanat/svg-v0.4.1.wasm",
		"https://plugins.dprint.dev/kjanat/sortpackagejson-0.2.1.wasm",
		"npm:@dprint/biome@0.13.10",
		"npm:@dprint/markdown@0.23.3",
		"npm:@dprint/ruff@0.8.6",
		"npm:@dprint/json@0.23.0",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-markup@0.27.3",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
		"npm:@dprint/prettier@0.70.0/plugin.json@97c0dccf54ed5b7343e7a3f6418e77bd80afcd2b74beed3a632689d47e392ddc"
	]
}
