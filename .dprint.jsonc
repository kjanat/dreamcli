{
	"useTabs": true,
	"indentWidth": 2,
	"newLineKind": "lf",
	"lineWidth": 100,
	"biome": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"quoteStyle": "single",
		"css.enabled": true,
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts", "*.ts.tpl"]
	},
	"markdown": {
		"textWrap": "maintain",
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts"]
	},
	"markup": {
		"html.void.selfClosing": false,
		"formatComments": true,
		"scriptIndent": true,
		"styleIndent": true,
		"vue.scriptIndent": true,
		"vue.styleIndent": true,
		"scriptFormatter": "biome",
		"associations": ["!README.md", "!docs/**/*.md", "!docs/.vitepress/twoslash/*.ts"]
	},
	"yaml": { "printWidth": 160 },
	"svg": { "useTabs": false },
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"associations": ["**/*.toml"],
		"commands": [
			{
				"associations": ["**/*.toml"],
				"exts": ["toml"],
				"command": "tombi format - --stdin-filename {{file_path}}",
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "npm i -g tombi@latest"
			}
		]
	},
	"prettier": {
		"singleQuote": true,
		"plugin.jsDoc": true,
		"printWidth": 60,
		"tabWidth": 2,
		"useTabs": false,
		"endOfLine": "lf",
		"associations": ["README.md", "docs/**/*.md", "docs/.vitepress/twoslash/*.ts", "!**"]
	},
	"ruff": { "preview": true, "indentWidth": 4 },
	"excludes": ["**/node_modules", "**/{*-,bun}lock(.*)?", "**/snapshots", "**/*.schema.json"],
	"plugins": [
		"https://plugins.dprint.dev/kjanat/svg-v0.4.1.wasm",
		"https://plugins.dprint.dev/kjanat/sortpackagejson-0.2.1.wasm",
		"https://plugins.dprint.dev/biome-0.13.6.wasm",
		"https://plugins.dprint.dev/markdown-0.22.1.wasm",
		"https://plugins.dprint.dev/ruff-0.8.2.wasm",
		"https://plugins.dprint.dev/json-0.23.0.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.3.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa",
		"https://plugins.dprint.dev/prettier-0.72.0.json@6e7af2cb2182a5a11358d3adde9ae0ef3b94b7d2e5dcfdd252e3f7c3916541fe"
	]
}
