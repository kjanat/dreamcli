{
	"$schema": "https://opencode.ai/config.json",
	"formatter": {
		"kprint": {
			"command": ["bunx", "@kjanat/fmt", "$FILE"],
			"extensions": [
				".js",
				".ts",
				".cjs",
				".cts",
				".mjs",
				".mts",
				".jsx",
				".tsx",
				".json",
				".jsonc",
				".md",
				".yml",
				".yaml"
			]
		}
	}
}
