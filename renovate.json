{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":semanticCommits"],
	"timezone": "Europe/Amsterdam",
	"automerge": false,
	"labels": ["kind: dependencies"],
	"assignees": ["kjanat"],
	"gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
	"prConcurrentLimit": 5,
	"prHourlyLimit": 2,
	"rangeStrategy": "bump",
	"ignorePaths": [
		".opencode/**",
		"**/node_modules/**",
		"**/dist/**",
		"**/coverage/**",
		"**/.vitepress/cache/**"
	],
	"github-actions": { "enabled": false },
	"customManagers": [
		{
			"description": "Extract root Bun catalog versions, including npm aliases, until the Bun manager supports catalogs.",
			"customType": "jsonata",
			"fileFormat": "json",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStrings": [
				"$each(catalog, function($value, $name) { ($alias := $match($value, /^npm:(.+)@([^@]+)$/); { 'depName': $name, 'packageName': $exists($alias) ? $alias.groups[0] : $name, 'currentValue': $exists($alias) ? $alias.groups[1] : $value }) })"
			],
			"datasourceTemplate": "npm",
			"depTypeTemplate": "bun.catalog"
		}
	],
	"packageRules": [
		{
			"description": "Keep minimum supported runtimes under manual control.",
			"matchDepTypes": ["engines", "devEngines.runtime", "devEngines.packageManager"],
			"enabled": false
		},
		{
			"description": "Update this repository's published package references during releases.",
			"matchPackageNames": ["@kjanat/dreamcli"],
			"enabled": false
		},
		{
			"description": "Require dashboard approval before opening major upgrade PRs.",
			"matchUpdateTypes": ["major"],
			"dependencyDashboardApproval": true
		},
		{
			"description": "Keep the npm and JSR Ansispeck dependencies in one upgrade PR.",
			"matchPackageNames": ["ansispeck", "@kjanat/ansispeck"],
			"groupName": "ansispeck"
		},
		{
			"description": "Batch workspace devDependencies and their Bun catalog entries once a week.",
			"matchDepTypes": ["devDependencies", "bun.catalog"],
			"groupName": "weekly dev dependencies",
			"groupSlug": "weekly-dev-dependencies",
			"groupSingleUpdates": true,
			"separateMajorMinor": false,
			"schedule": ["* 0-5 * * 1"],
			"dependencyDashboardApproval": false,
			"automerge": true,
			"platformAutomerge": false,
			"automergeSchedule": ["* 6-23 * * 1", "* * * * 0,2-6"]
		},
		{
			"matchPackageNames": ["twoslash", "twoslash-*", "shiki", "@shikijs/*"],
			"groupName": "Shiki and Twoslash",
			"groupSlug": "shiki-twoslash"
		},
		{
			"matchPackageNames": ["vitest", "@vitest/*"],
			"groupName": "Vitest",
			"groupSlug": "vitest"
		},
		{
			"matchPackageNames": ["typescript", "tsrs"],
			"groupName": "TypeScript compilers",
			"groupSlug": "typescript-compilers"
		},
		{
			"matchPackageNames": ["vite", "vitepress"],
			"groupName": "Vite and VitePress",
			"groupSlug": "vite-vitepress"
		},
		{
			"matchPackageNames": ["tsdown", "esbuild", "publint", "@arethetypeswrong/core"],
			"groupName": "package build and validation",
			"groupSlug": "package-build"
		},
		{
			"description": "Label runtime, compiler, bundler, formatter, linter, and test runner updates as toolchain updates.",
			"matchPackageNames": [
				"node",
				"bun",
				"typescript",
				"@biomejs/biome",
				"@kprint/kprint",
				"tsdown",
				"esbuild",
				"vitest",
				"@vitest/coverage-v8",
				"runner-run"
			],
			"labels": ["kind: toolchain"]
		}
	]
}
